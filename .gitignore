!data/raw/flood_observations/kolkata/documented_waterlogging_reports.csv
!data/raw/flood_observations/kolkata/documented_event_days_citylevel.csv

# Model binaries (regenerated by the pipeline)
models/**/*.joblib
models/**/*.npy

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key
.netrc

# OS / editors
.DS_Store
.idea/
.vscode/
*.log

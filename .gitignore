# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Data: raw/interim/processed datasets are reproducible from scripts and NOT committed
data/raw/**
data/interim/**
data/processed/**
data/imputed/**
!data/**/
!data/**/.gitkeep
